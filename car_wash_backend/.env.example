# Server
PORT=3000
NODE_ENV=development
# In production, set explicit comma-separated allowed origins
# Example: CORS_ORIGINS=https://admin.example.com,https://app.example.com
CORS_ORIGINS=*
# Set true when app is behind reverse proxy/load balancer
TRUST_PROXY=false

# PostgreSQL (must match your local Postgres user/password)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=your_postgres_password
DB_NAME=car_wash
DB_SYNCHRONIZE=false

# JWT
JWT_ACCESS_SECRET=your_access_secret_min_32_chars
JWT_REFRESH_SECRET=your_refresh_secret_min_32_chars

# PII encryption (required in production)
# Format: key-id:base64-32-byte-key,other-key-id:base64-32-byte-key
# Generate key example: openssl rand -base64 32
PII_ENCRYPTION_ACTIVE_KEY_ID=v1
PII_ENCRYPTION_KEYS=v1:replace_with_base64_32_byte_key

# Redis (start Redis locally: docker run -d -p 6379:6379 redis, or: redis-server)
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=optional_if_redis_has_auth

# SMS (optional for OTP)
# SMS_API_KEY=your_sms_provider_key
# SMS_ETHIOPIA_BASE_URL=https://smsethiopia.et/api/sms/send
# SMS_ETHIOPIA_SENDER_ID=Labyajo
# SMS_ETHIOPIA_TIMEOUT_MS=15000

# Dev helper: print OTP in backend logs
OTP_LOG_TO_CONSOLE=true

# Sequential dispatch offer timeout (milliseconds)
WASH_DISPATCH_ACCEPT_TIMEOUT_MS=30000

# Commissions
# COMMISSION_PER_OWNER=10
# COMMISSION_PER_OWNER_DIRECT=10
# COMMISSION_PER_OWNER_RECRUITER=5
# COMMISSION_PER_RECRUITED_SALES=10
