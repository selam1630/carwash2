# Server
PORT=3000

# PostgreSQL (must match your local Postgres user/password)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=your_postgres_password
DB_NAME=car_wash

# JWT
JWT_ACCESS_SECRET=your_access_secret_min_32_chars
JWT_REFRESH_SECRET=your_refresh_secret_min_32_chars

# Redis (start Redis locally: docker run -d -p 6379:6379 redis, or: redis-server)
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=optional_if_redis_has_auth

# SMS (optional for OTP)
# SMS_API_KEY=your_sms_provider_key
# SMS_ETHIOPIA_BASE_URL=https://smsethiopia.et/api/sms/send
# SMS_ETHIOPIA_SENDER_ID=Labyajo
# SMS_ETHIOPIA_TIMEOUT_MS=15000

# Dev helper: print OTP in backend logs
OTP_LOG_TO_CONSOLE=true

# Commissions
# COMMISSION_PER_OWNER=10
# COMMISSION_PER_OWNER_DIRECT=10
# COMMISSION_PER_OWNER_RECRUITER=5
# COMMISSION_PER_RECRUITED_SALES=10
